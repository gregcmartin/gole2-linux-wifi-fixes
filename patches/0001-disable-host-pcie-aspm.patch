+	/* disable_aspm only controls the Realtek DBI power-saving mechanism.
+	 * Firmware may leave standard PCIe link power saving enabled on both
+	 * ends of the link. Use the PCI core to disable those states as well
+	 * when explicitly requested, before starting device DMA.
+	 */
+	if (rtw_pci_disable_host_aspm) {
+		ret = pci_disable_link_state(pdev, PCIE_LINK_STATE_L0S |
+					     PCIE_LINK_STATE_L1 |
+					     PCIE_LINK_STATE_CLKPM);
+		if (ret) {
+			rtw_err(rtwdev, "cannot disable host PCIe ASPM: %d\n", ret);
+			goto err_pci_declaim;
+		}
+		rtw_info(rtwdev, "host PCIe ASPM and clock power management disabled\n");
+	}
+
